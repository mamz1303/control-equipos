rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios de la app (sesión anónima de Firebase)
    function app() { return request.auth != null; }

    // "Borrar datos" del /panel solo funciona si en la consola existe
    // config/app con el campo modoPruebas = true. Para producción: ponlo en false.
    function pruebas() {
      return get(/databases/$(database)/documents/config/app).data.modoPruebas == true;
    }
    function estadoValido() {
      return !('estado' in request.resource.data) || request.resource.data.estado in ['en_uso', 'disponible', 'revision'];
    }

    // Ajustes editables desde /panel (horarios de cierre de turno)
    match /ajustes/{id} {
      allow read, write: if app();
    }
    match /config/{id} {
      allow read: if app();
      allow write: if false;            // solo se edita desde la consola de Firebase
    }
    // Catálogo: tipos de equipo y personal (se gestionan desde /panel; no se borran, se dan de baja)
    match /tipos/{id} {
      allow read: if app();
      allow create, update: if app() && request.resource.data.nombre is string;
      allow delete: if false;
    }
    match /personal/{id} {
      allow read: if app();
      allow create, update: if app() && request.resource.data.nombre is string;
      allow delete: if false;
    }
    // Equipos: catálogo + estado actual (en uso / disponible)
    match /equipos/{id} {
      allow read: if app();
      allow create, update: if app() && estadoValido();
      allow delete: if false;
    }
    match /movimientos/{id} {
      allow read: if app();
      allow create: if app() && request.resource.data.tipo in ['retiro', 'devolucion', 'revision', 'liberacion'];
      allow update: if false;           // el historial no se puede alterar
      allow delete: if app() && pruebas();
    }
    match /fotos/{id} {
      allow read: if app();
      allow create: if app() && request.resource.data.data is string
                    && request.resource.data.data.size() < 400000;  // ~300 KB máx.
      allow update: if false;
      allow delete: if app() && pruebas();
    }
    match /usuarios/{uid} {
      allow read, write: if app() && request.auth.uid == uid;
    }
  }
}
